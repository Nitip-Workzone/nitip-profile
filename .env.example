# URL endpoint API backend nitip-core untuk digunakan oleh halaman pendaftaran web.
# Contoh: http://localhost:8000/api/v1 (Lokal) atau https://api.nihtip.com (VPS Production)
NUXT_PUBLIC_NITIP_API_URL=http://localhost:8000/api/v1

# Port & Host server (Optional, sudah didefinisikan default di docker-compose)
# PORT=3000
# HOST=0.0.0.0
